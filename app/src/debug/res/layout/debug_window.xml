<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/darker_gray"
    android:orientation="vertical"
    android:padding="8dp"
    tools:ignore="ButtonStyle">

    <TextView
        android:id="@+id/tv_app_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF000000"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="#FFFFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清除修改"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_profile1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="预设1"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_profile2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="预设2"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_profile3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="预设3"
            android:textAllCaps="false" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        tools:ignore="Autofill,TextFields">

        <EditText
            android:id="@+id/et_scheme"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:hint="scheme"
            android:maxLines="1"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="://" />

        <EditText
            android:id="@+id/et_host"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="host"
            android:maxLines="1"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":" />

        <EditText
            android:id="@+id/et_port"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:hint="prot"
            android:maxLines="1"
            android:singleLine="true" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="保存"
            android:textAllCaps="false" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="#FFFFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_feature1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="功能1"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_feature2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="功能2"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_feature3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="功能3"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_feature4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="功能4"
            android:textAllCaps="false" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_feature5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="功能5"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_feature6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="功能6"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_feature7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="功能7"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_feature8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="功能8"
            android:textAllCaps="false" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="#FFFFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end|center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_restart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="重启App"
            android:textAllCaps="false" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_close_tool"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="关闭工具"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_close_dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="关闭窗口"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>